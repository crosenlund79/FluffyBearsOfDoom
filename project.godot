; Engine configuration file.
; Fluffy Bears of Doom — Godot 4.3

config_version=5

[application]

config/name="Fluffy Bears of Doom"
config/description="Four adorable teddy bears steal the stuffing out of each other."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Settings="*res://scripts/settings.gd"
Assets="*res://scripts/assets.gd"
Sfx="*res://scripts/sfx.gd"
Music="*res://scripts/music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.957, 0.925, 0.863, 1)
